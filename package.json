{
  "name": "inlay-hints",
  "author": "lumine-code",
  "description": "Show inferred types and parameter names as inline labels.",
  "repository": "https://github.com/lumine-code/inlay-hints",
  "bugs": {
    "url": "https://github.com/lumine-code/inlay-hints/issues"
  },
  "keywords": [
    "inferred-types",
    "parameter-names",
    "virtual-text",
    "annotations",
    "lsp"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "docs",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "inlay-hints.provider": {
      "versions": {
        "^1.0.0": "consumeInlayHints"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "configSchema": {
    "enabled": {
      "title": "Enabled",
      "description": "Show inlay hints in the visible part of the editor. Also settable per language in scoped settings.",
      "scopeResolution": "grammar",
      "type": "boolean",
      "default": true
    },
    "maxLabelLength": {
      "title": "Maximum Label Length",
      "description": "Longer hint labels are truncated with an ellipsis.",
      "type": "integer",
      "minimum": 1,
      "default": 48
    }
  }
}
